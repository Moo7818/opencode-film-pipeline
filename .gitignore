# 白名单模式：忽略一切，仅放行白名单
*

!.gitignore
!README.md
!AGENTS.md
!opencode.json
!pyproject.toml
!uv.lock
!.python-version
!.opencode/
!.opencode/**
!doc/
!doc/**

# 白名单下的排除项
.opencode/credentials/**
.opencode/**/__pycache__/**
.opencode/**/*.pyc
.opencode/temp/**
**/*.egg-info/**

# Jupyter 检查点文件
.ipynb_checkpoints/
**/.ipynb_checkpoints/**

# MCP server venvs and storage
.opencode/mcp-servers/*/.venv/
.opencode/mcp-storage/

# macOS 系统文件
**/.DS_Store
