# 白名单模式：忽略一切，仅放行白名单
*

!.gitignore
!README.md
!AGENTS.md
!opencode.json
!.opencode/
!.opencode/**
!doc/
!doc/**

# 白名单下的排除项
.opencode/credentials/**
.opencode/**/__pycache__/**
.opencode/**/*.pyc
.opencode/temp/**

# MCP server venvs and storage
.opencode/mcp-servers/*/.venv/
.opencode/mcp-storage/
